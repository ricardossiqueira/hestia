[Unit]
Description=IoT Gateway MQTT router
After=network-online.target mosquitto-dynsec.service
Wants=network-online.target

[Service]
Type=simple
User=iot-gateway
Group=iot-gateway
EnvironmentFile=/etc/iot-gateway/environment
ExecStart=/usr/local/bin/iot-gateway run --config /etc/iot-gateway/gateway.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/iot-gateway

[Install]
WantedBy=multi-user.target
