[Unit]
Description=IoT Gateway admin UI (device registration)
After=network-online.target mosquitto.service iot-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/iot-gateway/admin-environment
ExecStart=/usr/local/bin/iot-gateway admin --config /etc/iot-gateway/gateway.yaml --listen 0.0.0.0:8081 --provision-script /usr/local/bin/mosquitto-provision-device
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
