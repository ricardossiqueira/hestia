[Unit]
Description=IoT Gateway admin process (device administration API)
After=network-online.target mosquitto-dynsec.service iot-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=iot-gateway
Group=iot-gateway
EnvironmentFile=/etc/iot-gateway/admin-environment
LoadCredential=dynsec-admin-password:/etc/iot-gateway/secrets/dynsec-admin-password
Environment=IOT_GATEWAY_DYNSEC_URL=tcp://127.0.0.1:1884
Environment=IOT_GATEWAY_DYNSEC_ADMIN_USERNAME=iot-gateway-dynsec-admin
Environment=IOT_GATEWAY_DYNSEC_ADMIN_PASSWORD_FILE=%d/dynsec-admin-password
ExecStart=/usr/local/bin/iot-gateway admin --config /etc/iot-gateway/gateway.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
